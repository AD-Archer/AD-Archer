# Environment Variables for Development/Testing
# Copy this file to .env and update with your actual values

# OpenAI API Key for AI features
OPENAI_API_KEY=fake_openai_api_key_sk_1234567890abcdef

# Node environment
NODE_ENV=development

# Site URL for absolute URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database URLs (if you add database later)
# DATABASE_URL=postgresql://username:password@localhost:5432/portfolio_db
# DATABASE_URL_TEST=postgresql://username:password@localhost:5432/portfolio_test_db

# Email configuration (for contact form)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# CONTACT_EMAIL=contact@antonioarcher.dev

# Authentication secrets (if you add auth later)
# NEXTAUTH_SECRET=your_nextauth_secret_here
# NEXTAUTH_URL=http://localhost:3000

# External API Keys (add as needed)
# GITHUB_TOKEN=ghp_your_github_token_here
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Feature flags
# ENABLE_CHAT=true
# ENABLE_ANALYTICS=false

# Rate limiting
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW=3600000
